<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban View -->
    <record id="view_salary_sheet_databank_kanban" model="ir.ui.view">
        <field name="name">salary.sheet.databank.kanban</field>
        <field name="model">salary.sheet.databank</field>
        <field name="arch" type="xml">
            <kanban default_group_by="year" class="o_kanban_small_column" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="month"/>
                <field name="year"/>
                <field name="date"/>
                <field name="company_id"/>
                <field name="total_employees"/>
                <field name="total_amount"/>
                <field name="currency_id"/>
                <field name="color"/>
                <field name="state"/>
                <field name="attachment_ids"/>
                <field name="attachment_count"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)} oe_kanban_card oe_kanban_global_click p-3 rounded shadow-sm">
                            <div class="o_dropdown_kanban dropdown">
                                <a role="button" class="dropdown-toggle o-no-caret btn btn-sm" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                    <span class="fa fa-ellipsis-v"/>
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <t t-if="widget.editable"><a role="menuitem" type="edit" class="dropdown-item">Edit</a></t>
                                    <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Delete</a></t>
                                    <ul class="oe_kanban_colorpicker" data-field="color"/>
                                </div>
                            </div>
                            
                            <!-- Month Salary Sheet Name -->
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top mb-2">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title text-primary fs-5 fw-bold">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <span t-attf-class="badge rounded-pill #{record.state.raw_value == 'confirmed' ? 'bg-success' : (record.state.raw_value == 'archived' ? 'bg-secondary' : 'bg-warning')} ms-auto">
                                        <field name="state"/>
                                    </span>
                                </div>

                                <!-- Month & Year Info -->
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge bg-info text-dark">
                                        <i class="fa fa-calendar me-1"/>
                                        <field name="month"/> / <field name="year"/>
                                    </span>
                                    <span t-if="record.date.raw_value" class="text-muted small">
                                        <i class="fa fa-clock-o me-1"/>
                                        <field name="date"/>
                                    </span>
                                </div>

                                <!-- Financial & Employee Summary -->
                                <div class="d-flex justify-content-between align-items-center border-top border-bottom py-2 my-2 text-dark">
                                    <div>
                                        <small class="text-muted d-block">Employees</small>
                                        <strong class="fs-6"><field name="total_employees"/></strong>
                                    </div>
                                    <div class="text-end">
                                        <small class="text-muted d-block">Total Amount</small>
                                        <strong class="fs-6 text-success"><field name="total_amount" widget="monetary"/></strong>
                                    </div>
                                </div>

                                <!-- ATTACHMENT OPTION JUST BELOW DETAILS -->
                                <div class="o_kanban_attachment_section mt-2 pt-2 border-top">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <small class="fw-bold text-uppercase text-muted">
                                            <i class="fa fa-paperclip me-1"/> Attachments (<field name="attachment_count"/>)
                                        </small>
                                    </div>
                                    <div class="mt-1">
                                        <field name="attachment_ids" widget="many2many_tags"/>
                                    </div>
                                </div>

                                <div class="o_kanban_record_bottom mt-2 pt-1 d-flex justify-content-between align-items-center">
                                    <small class="text-muted">
                                        <i class="fa fa-building me-1"/> <field name="company_id"/>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_salary_sheet_databank_form" model="ir.ui.view">
        <field name="name">salary.sheet.databank.form</field>
        <field name="model">salary.sheet.databank</field>
        <field name="arch" type="xml">
            <form string="Salary Sheet Databank">
                <header>
                    <button name="action_confirm" string="Confirm Sheet" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Set to Draft" type="object" invisible="state == 'draft'"/>
                    <button name="action_archive" string="Archive" type="object" class="btn-secondary" invisible="state == 'archived'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Month Salary Sheet Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. January 2026 Salary Sheet"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Period &amp; Date">
                            <field name="month"/>
                            <field name="year"/>
                            <field name="date"/>
                        </group>
                        <group string="Company &amp; Payroll Details">
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="total_employees"/>
                            <field name="total_amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Attachments" name="attachments">
                            <div class="alert alert-info" role="alert">
                                <strong>Many2many Attachments:</strong> Upload or attach multiple salary files (Excel, PDF, CSV, ZIP) for this sheet below.
                            </div>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Notes &amp; Description" name="notes">
                            <field name="notes" placeholder="Enter additional notes or summary here..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Tree / List View -->
    <record id="view_salary_sheet_databank_tree" model="ir.ui.view">
        <field name="name">salary.sheet.databank.list</field>
        <field name="model">salary.sheet.databank</field>
        <field name="arch" type="xml">
            <list string="Salary Sheets" multi_edit="1" sample="1">
                <field name="name"/>
                <field name="month"/>
                <field name="year"/>
                <field name="date"/>
                <field name="total_employees" sum="Total Employees"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="total_amount" sum="Total Amount" widget="monetary"/>
                <field name="attachment_count" string="Attachments"/>
                <field name="company_id"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'" decoration-muted="state == 'archived'"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_salary_sheet_databank_search" model="ir.ui.view">
        <field name="name">salary.sheet.databank.search</field>
        <field name="model">salary.sheet.databank</field>
        <field name="arch" type="xml">
            <search string="Search Salary Sheets">
                <field name="name" string="Salary Sheet Name"/>
                <field name="month"/>
                <field name="year"/>
                <field name="company_id"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Archived" name="filter_archived" domain="[('state', '=', 'archived')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Year" name="group_year" context="{'group_by': 'year'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'month'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
