<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Automated Daily Cron for Attendance Processing (Odoo 18 Compatible) -->
        <record id="ir_cron_factory_attendance_daily_processing" model="ir.cron">
            <field name="name">Factory Attendance Processing Engine: Daily Process</field>
            <field name="model_id" ref="model_attendance_processor_service"/>
            <field name="state">code</field>
            <field name="code">
# Process yesterday's biometric attendances
yesterday = datetime.date.today() - datetime.timedelta(days=1)
model.process_attendance_range(yesterday, yesterday)
            </field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
