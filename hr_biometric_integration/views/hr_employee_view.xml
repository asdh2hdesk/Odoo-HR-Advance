<odoo>
    <record id="view_employee_form_biometric" model="ir.ui.view">
        <field name="name">hr.employee.biometric</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='public']//group[@name='managers']" position="before">
                <group name="biometric_group" string="Biometric Information">
                    <field name="biometric_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>