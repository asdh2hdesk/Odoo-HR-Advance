<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sequence for Promotion Reference -->
    <record id="seq_hr_employee_promotion" model="ir.sequence">
        <field name="name">Employee Promotion Sequence</field>
        <field name="code">hr.employee.promotion</field>
        <field name="prefix">PROM/</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <!-- Form View -->
    <record id="view_hr_employee_promotion_form" model="ir.ui.view">
        <field name="name">hr.employee.promotion.form</field>
        <field name="model">hr.employee.promotion</field>
        <field name="arch" type="xml">
            <form string="Employee Promotion">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_apply" type="object" string="Apply Promotion" class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('done', 'cancel')"/>
                    <button name="action_draft" type="object" string="Set to Draft" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Employee Details">
                            <field name="employee_id" readonly="state == 'done'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="promotion_date" readonly="state == 'done'"/>
                            <field name="effective_date" readonly="state == 'done'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Current Details">
                            <field name="current_job_id" readonly="1"/>
                            <field name="current_department_id" readonly="1"/>
                            <field name="current_grade" readonly="state == 'done'"/>
                        </group>
                        <group string="New Details (Promotion)">
                            <field name="new_job_id" readonly="state == 'done'"/>
                            <field name="new_department_id" readonly="state == 'done'"/>
                            <field name="new_grade" readonly="state == 'done'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Reason &amp; Notes" name="reason_notes">
                            <group>
                                <field name="reason" placeholder="Explain the rationale for this promotion..." readonly="state == 'done'"/>
                                <field name="notes" placeholder="Internal HR notes..." readonly="state == 'done'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List / Tree View -->
    <record id="view_hr_employee_promotion_tree" model="ir.ui.view">
        <field name="name">hr.employee.promotion.list</field>
        <field name="model">hr.employee.promotion</field>
        <field name="arch" type="xml">
            <list string="Employee Promotions" decoration-info="state == 'draft'" decoration-warning="state == 'approved'" decoration-success="state == 'done'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="current_job_id"/>
                <field name="new_job_id"/>
                <field name="effective_date"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'approved'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hr_employee_promotion_search" model="ir.ui.view">
        <field name="name">hr.employee.promotion.search</field>
        <field name="model">hr.employee.promotion</field>
        <field name="arch" type="xml">
            <search string="Search Employee Promotions">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="new_job_id"/>
                <field name="new_department_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Applied" name="done" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="New Job Position" name="group_job" context="{'group_by': 'new_job_id'}"/>
                    <filter string="New Department" name="group_dept" context="{'group_by': 'new_department_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hr_employee_promotion" model="ir.actions.act_window">
        <field name="name">Employee Promotions</field>
        <field name="res_model">hr.employee.promotion</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_employee_promotion_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Log a new Employee Promotion!
            </p>
            <p>
                Track position upgrades, department changes, and grade revisions with effective dates and approval workflows.
            </p>
        </field>
    </record>

</odoo>
