<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_inherit_promotion_increment" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.promotion.increment</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            
            <!-- Add Smart Buttons -->
            <div name="button_box" position="inside">
                <button name="action_view_promotions"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-trophy"
                        groups="hr.group_hr_user">
                    <field name="promotion_count" widget="statinfo" string="Promotions"/>
                </button>
                <button name="action_view_increments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-line-chart"
                        groups="hr.group_hr_user">
                    <field name="increment_count" widget="statinfo" string="Increments"/>
                </button>
            </div>

            <!-- Add History Tab to Notebook -->
            <notebook position="inside">
                <page string="Promotions &amp; Increments" name="promotion_increment_history" groups="hr.group_hr_user">
                    <group string="Promotion History">
                        <field name="promotion_ids" readonly="1" nolabel="1">
                            <list string="Promotions">
                                <field name="name"/>
                                <field name="effective_date"/>
                                <field name="current_job_id"/>
                                <field name="new_job_id"/>
                                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'approved'" decoration-success="state == 'done'"/>
                            </list>
                        </field>
                    </group>
                    <group string="Salary Increment History">
                        <field name="increment_ids" readonly="1" nolabel="1">
                            <list string="Salary Increments">
                                <field name="name"/>
                                <field name="effective_date"/>
                                <field name="previous_wage"/>
                                <field name="increment_amount_monthly"/>
                                <field name="new_wage"/>
                                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'approved'" decoration-success="state == 'done'"/>
                            </list>
                        </field>
                    </group>
                </page>
            </notebook>

        </field>
    </record>

</odoo>
