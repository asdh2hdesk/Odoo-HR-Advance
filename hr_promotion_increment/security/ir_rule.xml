<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="hr_employee_promotion_comp_rule" model="ir.rule">
            <field name="name">Employee Promotion Multi-Company</field>
            <field name="model_id" ref="model_hr_employee_promotion"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="hr_salary_increment_comp_rule" model="ir.rule">
            <field name="name">Salary Increment Multi-Company</field>
            <field name="model_id" ref="model_hr_salary_increment"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
