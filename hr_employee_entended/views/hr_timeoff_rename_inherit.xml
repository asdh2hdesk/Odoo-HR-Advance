    <record id="hr_employee_view_form_leave_rename" model="ir.ui.view">
        <field name="name">hr.employee.view.form.leave.rename</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_holidays.view_employee_form_leave_inherit" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_time_off_dashboard']//div[1]/span[2]" position="replace">
                <span class="o_stat_text">Leaves</span>
            </xpath>
            <xpath expr="//button[@name='action_time_off_dashboard']//div[2]/span[1]" position="replace">
                <span class="o_stat_text">Leaves</span>
            </xpath>
            <xpath expr="//field[@name='leave_manager_id']" position="attributes">
                <attribute name="string">Leaves Approver</attribute>
            </xpath>
        </field>
    </record>

    <record id="res_users_view_form_leave_rename" model="ir.ui.view">
        <field name="name">hr.user.preferences.view.form.leave.rename</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="hr_holidays.res_users_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='%(hr_holidays.hr_leave_action_new_request)d'][1]" position="attributes">
                <attribute name="string">Request Leaves</attribute>
            </xpath>
            <xpath expr="//button[@name='%(hr_holidays.hr_leave_action_new_request)d']//div/span[2]" position="replace">
                <span class="o_stat_text">Leaves</span>
            </xpath>
        </field>
