    <record id="view_holidays_status_filter_rename" model="ir.ui.view">
        <field name="name">hr.leave.type.filter.rename</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.view_holidays_status_filter" />
        <field name="arch" type="xml">
            <xpath expr="//search//field[@name='name']" position="attributes">
                <attribute name="string">Leave Type</attribute>
            </xpath>
        </field>
    </record>

    
