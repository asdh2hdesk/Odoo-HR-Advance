        <field name="model">hr.leave.allocation.generate.multi.wizard</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_allocation_generate_multi_wizard_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form//field[@name='holiday_status_id']" position="attributes">
                <attribute name="string">Leave Type</attribute>
            </xpath>
            <xpath expr="//form//field[@name='name']" position="attributes">
                <attribute name="placeholder">e.g. Leave type (From validity start to validity end / no limit)</attribute>
            </xpath>
        </field>
    </record>

