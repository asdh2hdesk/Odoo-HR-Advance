<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_sync_log_list" model="ir.ui.view">
        <field name="name">attendance.sync.log.list</field>
        <field name="model">attendance.sync.log</field>
        <field name="arch" type="xml">
            <list string="Attendance Sync Logs"
                  decoration-danger="status == 'failed'"
                  decoration-muted="status == 'skipped'"
                  decoration-success="status == 'success'">
                <field name="sync_time"/>
                <field name="employee_id"/>
                <field name="employee_code"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="status"/>
                <field name="error_message" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_attendance_sync_log_form" model="ir.ui.view">
        <field name="name">attendance.sync.log.form</field>
        <field name="model">attendance.sync.log</field>
        <field name="arch" type="xml">
            <form string="Attendance Sync Log" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="employee_code"/>
                            <field name="attendance_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="check_in"/>
                            <field name="check_out"/>
                            <field name="status"/>
                            <field name="sync_time"/>
                        </group>
                    </group>
                    <group string="Error Message" invisible="status != 'failed'">
                        <field name="error_message" nolabel="1"/>
                    </group>
                    <group string="Raw API Response">
                        <field name="api_response" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_attendance_sync_log_search" model="ir.ui.view">
        <field name="name">attendance.sync.log.search</field>
        <field name="model">attendance.sync.log</field>
        <field name="arch" type="xml">
            <search string="Search Sync Logs">
                <field name="employee_id"/>
                <field name="employee_code"/>
                <field name="error_message"/>
                <filter string="Success" name="filter_success" domain="[('status', '=', 'success')]"/>
                <filter string="Skipped" name="filter_skipped" domain="[('status', '=', 'skipped')]"/>
                <filter string="Failed" name="filter_failed" domain="[('status', '=', 'failed')]"/>
                <separator/>
                <filter string="Today" name="filter_today"
                        domain="[('sync_time', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="groupby_status" context="{'group_by': 'status'}"/>
                    <filter string="Employee" name="groupby_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Sync Date" name="groupby_date" context="{'group_by': 'sync_time:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_attendance_sync_log" model="ir.actions.act_window">
        <field name="name">Attendance Sync Logs</field>
        <field name="res_model">attendance.sync.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_attendance_sync_log_search"/>
        <field name="context">{'search_default_filter_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No sync log entries yet.
            </p>
            <p>
                Entries appear here every time the Time Office
                synchronization runs, whether triggered by the
                scheduler or the "Sync Now" button.
            </p>
        </field>
    </record>
</odoo>
